{
  "name": "pi-status-bars",
  "version": "0.0.0",
  "private": true,
  "description": "Shared renderer for semantic Pi status segments above and below the editor",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.project.json && tsc -p tsconfig.tests.json",
    "lint": "mise exec -- biome check .",
    "test": "bun run scripts/run-tests.ts",
    "typecheck": "tsc -p tsconfig.project.json && tsc -p tsconfig.tests.json"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "dependencies": {
    "typebox": "1.3.27"
  }
}
